<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_bg"
    tools:context=".InstructionActivity">

    <!-- GUIDE: PASS (Left side for viewer, Top/Up tilt) -->
    <!-- Note: We keep the visual guides -->
    <LinearLayout
        android:id="@+id/boxPass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/game_pass"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/centerGuideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TILT UP"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="To PASS"
            android:textColor="@color/white"
            android:textSize="16sp" />
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/white"
            android:rotation="180"/> <!-- Flipped icon for visual cue -->
    </LinearLayout>

    <!-- Invisible Center Line -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/centerGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- GUIDE: CORRECT (Right side for viewer, Down tilt) -->
    <LinearLayout
        android:id="@+id/boxCorrect"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/game_correct"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/centerGuideline"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TILT DOWN"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="If CORRECT"
            android:textColor="@color/white"
            android:textSize="16sp" />
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/white"/>
    </LinearLayout>

    <!-- CENTER OVERLAY: COUNTDOWN -->
    <!-- We put a background circle so it pops out over the split colors -->
    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_circle_score"
        android:backgroundTint="@color/primary_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvInstCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:textColor="@color/text_dark"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place on\nForehead"
            android:textAlignment="center"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>